---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BaseItemCard from "../components/ui/BaseItemCard.astro";
import { getListingItem } from "../utils/adapters";

interface Props {
    collection: "publications" | "projects";
    title: string;
    subtitle?: string;
}

const { collection, title, subtitle } = Astro.props;
const entries = await getCollection(collection);

const getTimestamp = (entry: (typeof entries)[number]) => {
    if (entry.collection !== "publications" || !entry.data.date) return 0;
    return new Date(entry.data.date).getTime();
};

const sortedEntries = entries.sort((a, b) => {
    return getTimestamp(b) - getTimestamp(a);
});
---

<BaseLayout title={title}>
    {(title || subtitle) && (
        <header class="page-header">
            {title && <h1 class="page-title">{title}</h1>}
            {subtitle && <p class="page-subtitle">{subtitle}</p>}
        </header>
    )}

    <section class="item-list">
        {sortedEntries.map((entry) => {
            const item = getListingItem(entry);
            return <BaseItemCard {...item} href={`/${collection}/${entry.id}`} />;
        })}
    </section>
</BaseLayout>
