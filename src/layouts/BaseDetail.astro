---
import { getEntry, render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import BackLink from "../components/ui/BackLink.astro";
import Tag from "../components/ui/Tag.astro";
import Icon from "../components/ui/Icon.astro";
import { getListingItem, toAssetUrl } from "../utils/adapters";
import { SITE } from "../config";

interface Props {
    collection: "publications" | "projects";
    id: string;
}

const { collection, id } = Astro.props;
const entry = await getEntry(collection, id);

if (!entry) return Astro.redirect("/404");

const { Content } = await render(entry);
const detail = getListingItem(entry);

const meta = [];
if (detail.date) meta.push({ value: detail.date, icon: "Calendar" });
if (detail.authors) meta.push({ value: detail.authors, icon: "User" });
if (detail.extraInput) {
    meta.push({ value: detail.extraInput, icon: "Institution" });
}

const description = entry.data.description || detail.description || SITE.desc;
const heroImage = toAssetUrl(entry.data.image);
const ogImage = heroImage || SITE.ogImage;
---

<BaseLayout title={detail.title} description={description} ogImage={ogImage} ogType="article">
    <div class="flex justify-between items-center mb-4">
        <BackLink href={`/${collection}`} label={collection} />
        <div class="flex items-center gap-4">
            {detail.externalUrl && (
                <a href={detail.externalUrl} target="_blank" rel="noopener noreferrer" class="link">
                    View external
                </a>
            )}
        </div>
    </div>

    <article>
        <h1 class="page-title mb-4">{detail.title}</h1>

        {meta.length > 0 && (
            <div class="card-meta mb-4">
                {meta.map((m) => (
                    <span class="flex items-center gap-1">
                        <Icon name={m.icon} size={14} />
                        <span>{m.value}</span>
                    </span>
                ))}
            </div>
        )}

        {detail.tags && detail.tags.length > 0 && (
            <div class="flex gap-2 flex-wrap mb-4">
                {detail.tags.map((tag: string) => (
                    <Tag name={tag} />
                ))}
            </div>
        )}

        {heroImage && (
            <img
                src={heroImage}
                alt={detail.title}
                class="detail-hero-image"
            />
        )}

        <div class="prose">
            <Content />
        </div>
    </article>
</BaseLayout>
