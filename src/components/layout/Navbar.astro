---
import { NAV_LINKS } from "../../config";

const currentPath = Astro.url.pathname;
---

<nav class="navbar">
    <button
        type="button"
        class="nav-arrow nav-arrow-left"
        aria-label="Scroll navigation left"
    >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
                d="M15 6l-6 6 6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
        </svg>
    </button>
    <ul class="nav-links">
        {
            NAV_LINKS.map((link) => (
                <li>
                    <a
                        href={link.href}
                        class={`nav-link ${
                            currentPath === link.href ||
                            (link.href !== "/" &&
                                currentPath.startsWith(link.href))
                                ? "active"
                                : "inactive"
                        }`}
                    >
                        {link.label}
                        <span class="nav-link-line" />
                    </a>
                </li>
            ))
        }
    </ul>
    <button
        type="button"
        class="nav-arrow nav-arrow-right"
        aria-label="Scroll navigation right"
    >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
                d="M9 6l6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
        </svg>
    </button>
</nav>

<script>
    const navbar = document.querySelector<HTMLElement>(".navbar");
    const list = navbar?.querySelector<HTMLElement>(".nav-links");
    const leftButton = navbar?.querySelector<HTMLButtonElement>(".nav-arrow-left");
    const rightButton = navbar?.querySelector<HTMLButtonElement>(".nav-arrow-right");

    if (navbar && list && leftButton && rightButton) {
        const updateArrows = () => {
            const maxScroll = list.scrollWidth - list.clientWidth;
            navbar.classList.toggle("can-scroll-left", list.scrollLeft > 1);
            navbar.classList.toggle(
                "can-scroll-right",
                list.scrollLeft < maxScroll - 1,
            );
        };

        const scrollByPage = (direction: number) => {
            list.scrollBy({
                left: direction * Math.max(list.clientWidth * 0.7, 120),
                behavior: "smooth",
            });
        };

        leftButton.addEventListener("click", () => scrollByPage(-1));
        rightButton.addEventListener("click", () => scrollByPage(1));
        list.addEventListener("scroll", updateArrows, { passive: true });
        window.addEventListener("resize", updateArrows);
        updateArrows();
        document.fonts.ready.then(updateArrows);
    }
</script>
