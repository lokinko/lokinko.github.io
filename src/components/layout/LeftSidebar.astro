---
import { SOCIALS } from "../../config";
import { getEntry } from "astro:content";
import Icon from "../ui/Icon.astro";
import { toAssetUrl } from "../../utils/adapters";

const bio = (await getEntry("bio", "bio"))?.data;
---

<aside class="sidebar max-lg:flex-row max-lg:flex-wrap max-lg:gap-3 max-md:gap-2">
    <div class="flex flex-col items-center text-center max-lg:flex-row max-lg:text-left max-lg:gap-3 max-lg:items-center max-md:gap-2">
        {bio?.avatar && (
            <img
                src={toAssetUrl(`/${bio.avatar}`)}
                alt={`Avatar of ${bio.name}`}
                width={160}
                height={160}
                class="sidebar-avatar"
                loading="eager"
            />
        )}
        <div class="flex min-w-0 flex-col items-center max-lg:items-start">
            {bio?.name && <h1 class="sidebar-name">{bio.name}</h1>}
            {bio?.institution && (
                <p class="sidebar-info">
                    <Icon name="Institution" size={16} />
                    {bio.institution}
                </p>
            )}
            {bio?.shortBio && (
                <p class="sidebar-bio mt-2">{bio.shortBio}</p>
            )}
            <div class="flex gap-1 flex-wrap items-center justify-center max-lg:justify-start mt-1">
                {SOCIALS.map((social) => (
                    <a
                        href={social.href}
                        aria-label={social.linkTitle}
                        title={social.linkTitle}
                        target="_blank"
                        rel="noreferrer"
                        class="social-link"
                    >
                        <Icon name={social.icon} size={24} />
                    </a>
                ))}
            </div>
        </div>
    </div>
</aside>
