---
export interface TimelineItemData {
    title: string;
    period: string;
    subtitle: string;
    description?: string;
}

interface Props {
    items: TimelineItemData[];
}

const { items } = Astro.props;
---

<div class="timeline flex flex-col">
    {
        items.map((item) => (
            <div class="timeline-item flex gap-[9px]">
                <div class="timeline-marker flex flex-col items-center shrink-0">
                    <div class="dot rounded-full bg-accent z-10 w-[5px] h-[5px] mt-[10.5px]" />
                    <div class="timeline-line flex-1 w-[2px] bg-border my-2" />
                </div>
                <div class="timeline-content flex-1 pb-3">
                    <div class="entry-header flex justify-between items-baseline gap-4 mb-1">
                        <span class="body font-bold">{item.title}</span>
                        <span class="body-xs font-semibold opacity-75 whitespace-nowrap">
                            {item.period}
                        </span>
                    </div>
                    <div class="body-sm font-semibold opacity-90">
                        {item.subtitle}
                    </div>
                    {item.description && (
                        <div class="body-sm mt-1">
                            {item.description}
                        </div>
                    )}
                </div>
            </div>
        ))
    }
</div>
