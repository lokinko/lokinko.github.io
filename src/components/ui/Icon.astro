---
import { ICONS } from "../../assets/icons";

interface Props {
    name: string;
    size?: number | string;
}

const { name, size = 24 } = Astro.props;
const iconContent = ICONS[name];
if (!iconContent) {
    throw new Error(`[Unknown Icon]: ${name}`);
}
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={iconContent}
/>
